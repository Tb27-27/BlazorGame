@page "/shop"
@using Product
@using Sales

<PageTitle>Winkel - Adventurer's Guild</PageTitle>

<h1>Welkom in de Adventurer's Guild</h1>
<p>Huidig Goud in de kas: <strong>@ShopGold Goudstukken</strong></p>

<hr />

@if (CurrentAdventurer != null)
{
    <div class="quest-board">
        <h3>Klant aan de balie: @CurrentAdventurer.Name (Level @CurrentAdventurer.Level)</h3>
        <p><em>"Ik moet een Vliegende Vuursteen verslaan! Ik heb een <strong>Ranged</strong> wapen en <strong>Light</strong> armor nodig."</em></p>
        <p>Budget van klant: @CurrentAdventurer.GoldBudget G</p>
    </div>

    <div class="inventory">
        <h3>Jouw Voorraad (Klik om toe te voegen)</h3>
        @foreach (var item in Inventory)
        {
            <button class="btn btn-outline-primary m-1" @onclick="() => AddToLoadout(item)">
                @item.Name - @item.Price G
            </button>
        }
    </div>

    <div class="loadout">
        <h3>Huidige Loadout voor @CurrentAdventurer.Name</h3>
        <ul>
            @foreach (var slot in CurrentLoadout.Slots)
            {
                <li>@slot.SlotType: @slot.EquippedItem.Name</li>
            }
        </ul>
        <h4>Totaalprijs: @CurrentLoadout.TotalCost G</h4>

        <button class="btn btn-success" @onclick="SellAndSendOnQuest">
            Verkoop Uitrusting & Stuur op Queeste!
        </button>
    </div>

    @if (!string.IsNullOrEmpty(ResultMessage))
    {
        <div class="alert alert-info mt-3">
            @ResultMessage
        </div>
    }
}

@code {

    private decimal ShopGold = 500m;
    private Adventurer CurrentAdventurer;
    private List<GuildItem> Inventory = new();
    private QuestLoadout CurrentLoadout;
    private string ResultMessage = "";


    protected override void OnInitialized()
    {
        // Maak categorieën aan (vervanger voor ProductCategory)
        var catWeaponRanged = new ItemCategory(1, "Bogen", EquipmentType.Weapon, "Lange afstands wapens");
        var catWeaponMelee = new ItemCategory(2, "Zwaarden", EquipmentType.Weapon, "Korte afstands wapens");
        var catArmorLight = new ItemCategory(3, "Leder", EquipmentType.Armor, "Lichte bepantsering");

        // Vul de winkel
        Inventory.Add(new GuildItem(1, "Elvenboog", 150m, catWeaponRanged));
        Inventory.Add(new GuildItem(2, "IJzeren Zwaard", 100m, catWeaponMelee));
        Inventory.Add(new GuildItem(3, "Lederen Harnas", 75m, catArmorLight));

        // Maak de eerste klant aan
        CurrentAdventurer = new Adventurer(1, "Sir Lancelot", 5, 300m);
        CurrentLoadout = new QuestLoadout(1, CurrentAdventurer, new List<LoadoutSlot>(), 0m);
    }

    private void AddToLoadout(GuildItem item)
    {
        // Voeg het item toe aan de lijst en update de prijs
        CurrentLoadout.Slots.Add(new LoadoutSlot(CurrentLoadout.Slots.Count + 1, item, 1, item.Category.MainType.ToString()));
        CurrentLoadout.TotalCost += item.Price;
    }

    private void SellAndSendOnQuest()
    {
        // Simpele check of de avonturier genoeg geld heeft
        if (CurrentLoadout.TotalCost > CurrentAdventurer.GoldBudget)
        {
            ResultMessage = "De avonturier heeft niet genoeg goud!";
            return;
        }

        // Hier test je of de spullen goed zijn voor de Queeste (Vliegende Vuursteen = Ranged + Light)
        bool hasRanged = CurrentLoadout.Slots.Any(s => s.EquippedItem.Name == "Elvenboog");
        bool hasLightArmor = CurrentLoadout.Slots.Any(s => s.EquippedItem.Name == "Lederen Harnas");

        if (hasRanged && hasLightArmor)
        {
            // Tel goud erbij op
            ResultMessage = "Succes! De avonturier heeft het monster verslagen. Je hebt de winst binnen!";
            ShopGold += CurrentLoadout.TotalCost;
        }
        else
        {
            // Straf voor een slechte verkoper
            ResultMessage = "Mislukt! De avonturier had de verkeerde spullen en is opgegeten. Je verliest goud als compensatie aan de nabestaanden...";
            ShopGold -= 100m; 
        }

        // Reset voor de volgende klant
        CurrentLoadout.Slots.Clear();
        CurrentLoadout.TotalCost = 0;
    }
}